@startuml
title Объединённый алгоритм предобработки данных и обучения модели FatigueWristNet

start

partition "Исходные данные" {
  :Загрузить набор данных PhysioNet Wearable Device Dataset;
  :Загрузить файлы сигналов Empatica E4;

  note right
    Каналы: ACC, BVP, 
    EDA, TEMP, HR, tags.csv
  end note
}

partition "Предварительная обработка данных" {
  :Считать временные ряды по каждому субъекту;
  :Синхронизировать каналы по временным меткам;

  if (Есть пропуски или разная частота дискретизации?) then (да)
    :Выполнить линейную интерполяцию;
    :Привести все каналы к единой временной сетке;
  else (нет)
    :Оставить исходную временную структуру;
  endif

  :Сформировать многоканальный сигнал субъекта;

  :Разделить каналы на группы;

  note right
    Инерциальная ветвь:
    - ACC / IMU-каналы

    Физиологическая ветвь:
    BVP, EDA, TEMP, HR
  end note

  :Выполнить субъектную нормализацию z-score;
  :Сформировать окна длительностью 5 секунд;
  :Сопоставить окна с метками событий из tags.csv;

  if (Окно относится к периоду утомления?) then (да)
    :Назначить метку fatigue = 1;
  else (нет)
    :Назначить метку fatigue = 0;
  endif

  :Удалить некорректные или неполные окна;
  :Сформировать итоговую выборку;
}

partition "Подготовка схемы обучения" {
  :Инициализировать схему LOSO-CV;
  :Сформировать список субъектов;
  :Создать таблицу результатов;

  note right
    LOSO-CV: на каждой итерации 
    один субъект исключается из 
    обучающей выборки и 
    используется для тестирования
  end note
}

while (Остались субъекты для LOSO?) is (да)

  partition "Подготовка текущей LOSO-итерации" {
    :Выбрать тестового субъекта;
    :Разделить данные на train / validation / test;

    if (Есть дисбаланс классов?) then (да)
      :Рассчитать веса классов;
      :Подготовить функцию потерь с весовыми коэффициентами;
    else (нет)
      :Использовать стандартные веса классов;
    endif
  }

  partition "Обучение модели" {
    while (Ранняя остановка не сработала?) is (да)

      :Начать новую эпоху обучения;

      while (Есть batch в эпохе?) is (да)
        :Получить batch обучающих окон;

        :Разделить входной тензор на группы каналов;
        :Передать данные в IMU- и Phys-ветви;

        :Извлечь локальные временные признаки;
        :Применить темпоральное внимание;
        :Объединить признаки двух ветвей;

        :Выполнить классификацию;
        :Получить вероятность класса fatigue;

        :Вычислить функцию потерь с учётом весов классов;
        :Выполнить обратное распространение ошибки;
        :Обновить параметры модели через оптимизатор;
      endwhile (нет)

      :Оценить модель на validation-наборе;
      :Рассчитать метрики качества;
      :Обновить планировщик скорости обучения;

      if (Метрика улучшилась?) then (да)
        :Сохранить лучшую версию модели;
        :Сбросить счётчик ранней остановки;
      else (нет)
        :Увеличить счётчик ранней остановки;
      endif

    endwhile (нет)
  }

  partition "Оценка текущей LOSO-итерации" {
    :Загрузить лучшую модель текущей итерации;
    :Подобрать оптимальный порог классификации по validation-набору;
    :Выполнить инференс на test-субъекте;

    :Рассчитать итоговые метрики;

    note right
      Метрики: Accuracy, Precision, 
      Recall, F1-macro, 
      ROC-AUC, PR-AUC
    end note

    :Сохранить результаты LOSO-итерации;
  }

endwhile (нет)

partition "Итоговая агрегация" {
  :Усреднить метрики по всем LOSO-итерациям;
  :Сформировать итоговую оценку качества модели;
  :Сохранить финальные веса модели;
  :Подготовить модель к интеграции в ML-сервис;
  note right
    Квантизация модели для оптимизации
    и ускорения инференса на 
    мобильных устройствах
  end note
}

stop

@enduml