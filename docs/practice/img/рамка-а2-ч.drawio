                <UserObject label="а) Формирование скрытого представления инерциальной ветки&#xa;$$&#xa;X^{imu} \xrightarrow{\mathrm{Conv1D}} H = \{h_t\}_{t = 1}^{T&#39;},&#xa;$$" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-0">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="782" y="19.69" width="709.87" height="118.31" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="б) Вычисление промежуточного представления механизма внимания&#xa;$$&#xa;u_t = \tanh(W_a h_t + b_a), \qquad&#xa;e_t = w_b^\top u_t + b_b,&#xa;$$" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-1">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="783" y="132" width="769.87" height="105" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="в) Нормирование весов внимания и агрегация инерциальных признаков&#xa;$$&#xa;\alpha_t = \frac{\exp(e_t)}{\sum_{\tau} \exp(e_{\tau})}, \qquad&#xa;z^{imu} = \sum_t \alpha_t h_t,&#xa;$$" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-2">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="782" y="252" width="799.43" height="132" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="г) Агрегация признаков физиологической ветки" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-3">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="780" y="366" width="718.43" height="81" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="д) Применение профильного dropout" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-4">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="780" y="519" width="417" height="60" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="е) Слияние признаковых представлений" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-5">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="774" y="636" width="463.43" height="72" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="ж) Вычисление логита и вероятности класса" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-6">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="774" y="753" width="508.43" height="72" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="з) Вычисление базовой взвешенной бинарной кросс-энтропии&#xa;$$&#xa;L_{BCE} = - w_{pos} y \log \hat{p} - (1 - y) \log(1 - \hat{p}),&#xa;$$" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-7">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="771" y="861" width="706.43" height="135" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="и) Вычисление вероятности истинного класса&#xa;$$&#xa;p_t = y \hat{p} + (1 - y)(1 - \hat{p}),&#xa;$$" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-8">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="782" y="984" width="514.43" height="135" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="$$&#xa;z^{phys} = \mathrm{GAP}(\mathrm{PhysioEncoder}(X^{phys})), \qquad&#xa;\tilde{z}^{phys} = m_{phys} z^{phys},&#xa;$$" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-9">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="809" y="426" width="718.43" height="78" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="$$&#xa;\tilde{p} = r p, \qquad r \sim \mathrm{Bernoulli}(1 - p_{drop}),&#xa;$$" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-10">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="957" y="570" width="457.43" height="69" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="$$&#xa;z = [z^{imu}; \tilde{z}^{phys}; \tilde{p}],&#xa;$$" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-11">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="909" y="681" width="390" height="75" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="$$&#xa;\ell = f_{cls}(z), \qquad&#xa;\hat{p} = \sigma(\ell),&#xa;$$" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-12">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="945" y="794" width="390" height="66" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="к) Вычисление Focal Losss для отдельного объекта&#xa;$$&#xa;L_{FL} = (1 - p_t)^{\gamma} L_{BCE},&#xa;$$" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-13">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="783" y="1122" width="591" height="135" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="л) Усреднение функции потерь по батчу&#xa;$$&#xa;\mathcal{L} = \frac{1}{B} \sum_{i = 1}^{B} L_{FL}^{(i)}.&#xa;$$" placeholders="1" name="Variable" id="x53uPzn2o_b8FNP-H33N-14">
                    <mxCell style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;labelBackgroundColor=none;fontFamily=Times New Roman;" parent="dlsD8I_IZNfI1uVVBORZ-1" vertex="1">
                        <mxGeometry x="782" y="1257" width="514.43" height="135" as="geometry"/>
                    </mxCell>
                </UserObject>
            </root>
        </mxGraphModel>
    </diagram>
